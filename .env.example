# Copy to .env.aws.local AFTER a stack deploy; use that account's stack outputs.
# Every VITE_ value is public. Never add keys, passwords, tokens, or client secrets.
#
# Seed / verify / publish read these from the shell (not from this file):
#   AWS_PROFILE   CLI/SSO profile for the target account
#   AWS_REGION    e.g. us-east-1
#   SALT_STACK    CloudFormation/SAM stack name
#   SALT_ACCOUNT  12-digit account ID (must match the profile)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_ISSUER=
VITE_API_URL=
VITE_AUTH_SCOPE=
VITE_AUTH_CALLBACK_URL=
VITE_AUTH_LOGOUT_URL=
# Optional local-only port (default 3000). Keep deployed FrontendOrigin in sync.
DEV_PORT=3000
