{
    "name": "asset-tracker-auth-starter",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite --config vite.config.local.mjs",
        "dev:aws": "vite --mode aws",
        "build": "vite build --mode aws",
        "preview": "vite preview",
        "test": "node --test tests/*.test.mjs",
        "test:local": "node tests/local-smoke.mjs",
        "check:build": "node scripts/check-frontend-build.mjs",
        "seed:sandbox": "node scripts/seed-sandbox-assets.mjs",
        "verify:sandbox": "node scripts/verify-sandbox-assets.mjs",
        "publish:frontend": "node scripts/publish-frontend.mjs"
    },
    "dependencies": {
        "aws-amplify": "6.20.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "vite": "8.3.3"
    }
}
